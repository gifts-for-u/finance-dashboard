rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SECURITY MODEL
    // =========================================================================
    // Arsitektur aplikasi ini serverless (BaaS). Firestore Security Rules
    // adalah SATU-SATUNYA lapisan otorisasi dan validasi — tidak ada backend
    // API lain. Lihat PRD.md Section 8 dan AGENTS.md Section 2.1.
    //
    // Invarian yang dijaga:
    //   1. Setiap akses ke /users/{uid}/... HARUS oleh auth.uid == uid.
    //   2. Semua koleksi di luar /users/{uid}/... default deny.
    //   3. Shape dokumen divalidasi untuk mencegah injeksi field liar
    //      (defense in depth, walau server sudah di-scope per-uid).
    // =========================================================================

    // ---- Helper functions ----

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Amount validator.
    // INVARIAN: 0 <= amount <= 1e12. allow 0 karena:
    //   - addBudget() mengizinkan reset budget ke 0 (= "hapus budget").
    //   - Beberapa entri historis mungkin amount = 0 (placeholder).
    //   - Client-side validateAmount() yang reject <=0 hanya untuk UI hints,
    //     bukan untuk enforcement. Rules allow 0 demi backward-compat data.
    function isValidAmount(val) {
      return val is number && val >= 0 && val <= 1000000000000;
    }

    // Shape validator untuk Category object dalam array categories[].
    // Field lain (custom) ditolak agar tidak ada injeksi metadata liar.
    function isValidCategory(cat) {
      return cat.keys().hasOnly(['id', 'name', 'color', 'icon', 'isDefault'])
          && cat.id is string
          && cat.name is string
          && cat.color is string
          && cat.icon is string
          && cat.isDefault is bool;
    }

    // ---- User data hierarchy ----

    match /users/{userId} {
      // User root document: read OK, write deny by default.
      // Aplikasi tidak menulis ke /users/{uid} (root), hanya ke subcollections.
      allow read: if isOwner(userId);
      allow write: if false;

      // Categories: { categories: Category[] }
      // Setiap Category harus sesuai shape (lihat isValidCategory).
      match /categories/{catId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['categories'])
          && request.resource.data.categories is list
          && request.resource.data.categories.size() <= 200
          && request.resource.data.categories.all(isValidCategory);
      }

      // Monthly financial data:
      //   { incomes?: IncomeItem[], expenses?: ExpenseItem[], budgets?: map<string, number> }
      //
      // Setiap write via FinanceContext.updateMonthDoc() pakai
      //   setDoc(monthRef, payload, { merge: true })
      // sehingga request.resource.data adalah MERGED state (data existing
      // ditambah payload). Validasi di bawah mempertimbangkan itu.
      //
      // Catatan PENTING:
      //   - Budget 'allow' 0 untuk reset budget (lihat isValidAmount).
      //   - Income/Expense item TIDAK divalidasi element-by-element di rules
      //     karena Firestore rules tidak support loop ke array element dengan
      //     mudah dan cost-nya tinggi. Validasi field ada di client
      //     (FinanceContext.validateAmount, dll.) — lihat PRD.md Section 8.1.
      //   - hasOnly(['incomes', 'expenses', 'budgets']) strict. Jika di masa
      //     depan ada field baru (mis. 'updatedAt'), HARUS update rules ini
      //     bersamaan — lihat AGENTS.md Section 2.1.
      match /months/{monthId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['incomes', 'expenses', 'budgets'])
          && (!('incomes' in request.resource.data)
              || request.resource.data.incomes is list)
          && (!('expenses' in request.resource.data)
              || request.resource.data.expenses is list)
          && (!('budgets' in request.resource.data) || (
                request.resource.data.budgets is map
                // setiap value di budgets map harus berupa amount valid
                && request.resource.data.budgets.values().all(isValidAmount)
              ));
      }

      // Recurring templates: reserved untuk fitur masa depan.
      // Saat ini tidak ada write dari aplikasi; di-strict untuk write deny.
      match /templates/{templateId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Migration status: hanya baca, tulis deny.
      match /migration/{migrationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Catch-all untuk subcollection masa depan di bawah user namespace.
      // Default deny write — harus di-explicit-kan saat menambah subcollection.
      match /{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Default deny untuk semua path di luar /users/{userId}.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}